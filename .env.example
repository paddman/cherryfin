CHERRYFIN_ENVIRONMENT=development
CHERRYFIN_LOG_LEVEL=INFO

# OpenAI-compatible endpoint: LM Studio, Ollama, vLLM, SGLang, or hosted provider.
CHERRYFIN_LLM_BASE_URL=http://127.0.0.1:1234/v1
CHERRYFIN_LLM_API_KEY=local
CHERRYFIN_LLM_MODEL=
CHERRYFIN_LLM_TIMEOUT_SECONDS=90

# Safety defaults. Live execution remains disabled until a reviewed connector is installed.
CHERRYFIN_EXECUTION_ENABLED=false
CHERRYFIN_MAX_TRANSACTION_NOTIONAL=0
CHERRYFIN_DEFAULT_CURRENCY=THB
CHERRYFIN_MAX_MARKET_DATA_AGE_MINUTES=30
CHERRYFIN_MAX_NEWS_AGE_HOURS=24
