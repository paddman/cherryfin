CHERRYFIN_ENVIRONMENT=development
CHERRYFIN_LOG_LEVEL=INFO

CHERRYFIN_LLM_BASE_URL=http://127.0.0.1:1234/v1
CHERRYFIN_LLM_API_KEY=local
CHERRYFIN_LLM_MODEL=
CHERRYFIN_LLM_TIMEOUT_SECONDS=90

# One SQLite file is retained for the default tenant. Other tenants receive isolated files.
CHERRYFIN_INTELLIGENCE_STORE_PATH=./data/intelligence.db
CHERRYFIN_DEFAULT_TENANT_ID=default
CHERRYFIN_MAX_EVIDENCE_BYTES=20000000
CHERRYFIN_MAX_INLINE_EVIDENCE_TRUST=0.60

# Platform administrator key. Store it in a secret manager in production.
CHERRYFIN_ADMIN_API_KEY=

# JSON object keyed by tenant ID. Roles are fixed in configuration, never trusted from headers.
# Example:
# CHERRYFIN_TENANT_CREDENTIALS={"acme":{"api_key":"replace-with-secret","role":"analyst","actor_id":"acme-agent"}}
CHERRYFIN_TENANT_CREDENTIALS={}

CHERRYFIN_EXECUTION_ENABLED=false
CHERRYFIN_MAX_TRANSACTION_NOTIONAL=0
CHERRYFIN_DEFAULT_CURRENCY=THB

CHERRYFIN_MAX_MARKET_DATA_AGE_MINUTES=30
CHERRYFIN_MAX_NEWS_AGE_HOURS=24
